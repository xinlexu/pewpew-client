[Unit]
Description=PewPew bounded route probe
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
DynamicUser=yes
StateDirectory=pewpew-probe
ExecStart=/usr/bin/python3 -B /opt/pewpew-probe/current/server.py
LoadCredential=tls.key:/etc/pewpew-probe/server.key
Restart=on-failure
RestartSec=30
MemoryMax=64M
CPUQuota=20%
TasksMax=16
LimitNOFILE=64
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
